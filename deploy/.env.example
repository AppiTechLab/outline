# Copy to .env and fill in. Never commit .env — it holds secrets.
#   cp .env.example .env
#
# Full list of supported variables: ../.env.sample

# ──────────────────────────────────────────────
#  ADDRESS
# ──────────────────────────────────────────────

# The address you browse to. Must match exactly — scheme included, no trailing
# slash — or sign-in redirects and cookies break.
#
# Localhost (default):
OUTLINE_URL=http://localhost:3000
#
# Public domain behind Caddy:
#   OUTLINE_URL=https://docs.example.com

# Host port to publish Outline on. Only bound to 127.0.0.1.
OUTLINE_PORT=3000

# ──────────────────────────────────────────────
#  PUBLIC DOMAIN & TLS  (only for --profile proxy)
# ──────────────────────────────────────────────

# Leave these blank when running on localhost. To serve a real domain, set both,
# point an A/AAAA record at this host, set OUTLINE_URL above to https://<domain>,
# and start with:  docker compose --profile proxy up -d
OUTLINE_DOMAIN=
LETSENCRYPT_EMAIL=

# ──────────────────────────────────────────────
#  DATABASE
# ──────────────────────────────────────────────

# Alphanumeric only — this goes into DATABASE_URL unescaped, so characters like
# @ : / # ? would corrupt the connection string.
#   openssl rand -hex 24
#
# Only read when Postgres first initialises its data directory. Changing it
# later requires ALTER USER inside the container; see README.
POSTGRES_PASSWORD=

# Defaults are fine.
POSTGRES_USER=outline
POSTGRES_DB=outline

# ──────────────────────────────────────────────
#  SECRETS
# ──────────────────────────────────────────────

# SECRET_KEY must be EXACTLY 64 hexadecimal characters — 32 random bytes, not
# 32 characters. env.ts enforces @Length(64, 64) and the server refuses to
# start otherwise.
#   openssl rand -hex 32
#
# Changing it later invalidates all existing sessions and makes previously
# stored encrypted values unreadable. Set once, then back it up.
SECRET_KEY=

# Any non-empty value. Use a second, independent string — don't reuse the above.
#   openssl rand -hex 32
UTILS_SECRET=

# ──────────────────────────────────────────────
#  AUTHENTICATION — GitLab via OIDC  (the one in use)
# ──────────────────────────────────────────────

# GitLab is an OpenID Connect provider, so Outline's generic OIDC plugin talks
# to it directly — the bundled `gitlab` plugin is unfurling and issue linking
# only, not sign-in.
#
# On gitlab.com: avatar -> Edit profile -> Applications
#   https://gitlab.com/-/user_settings/applications
#   Redirect URI:  http://localhost:3000/auth/oidc.callback
#                  (or https://YOUR_DOMAIN/auth/oidc.callback)
#   Scopes:        openid, profile, email      <- NOT api
#   Confidential:  yes
#
# Each person signing in must have a PUBLIC EMAIL set on their GitLab profile.
# GitLab omits the email and email_verified claims otherwise, and Outline
# cannot provision an account without an email.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Base URL only. Outline fetches /.well-known/openid-configuration and
# discovers the authorize, token and userinfo endpoints from it. Set
# OIDC_AUTH_URI / OIDC_TOKEN_URI / OIDC_USERINFO_URI only if discovery fails.
OIDC_ISSUER_URL=https://gitlab.com

# Shown on the sign-in button.
OIDC_DISPLAY_NAME=GitLab

OIDC_SCOPES=openid profile email
OIDC_USERNAME_CLAIM=preferred_username

# ──────────────────────────────────────────────
#  AUTHENTICATION — Discord  (superseded by OIDC)
# ──────────────────────────────────────────────
#
# Kept only until GitLab sign-in is verified to land in the existing admin
# account. Clear these afterwards and recreate the container; the sign-in
# button disappears when the credentials are absent.

# Required. Without a configured provider the login page has no sign-in options
# and you cannot create the first account.
#
# Create an application at https://discord.com/developers/applications
#   OAuth2 -> Redirects:  http://localhost:3000/auth/discord.callback
#                         (or https://YOUR_DOMAIN/auth/discord.callback)
# Discord accepts plain-http localhost redirects, so no tunnel is needed.
# Docs: https://docs.getoutline.com/s/hosting/doc/discord-g4JdWFFub6
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Strongly recommended. The ID of a Discord server you own.
#   - Only members of that server can sign in; everyone else is rejected
#   - The server's name and icon become the Outline workspace name and logo
# Without it the workspace ends up unnamed and ANY Discord account can sign in.
# Get it: Discord -> User Settings -> Advanced -> enable Developer Mode, then
# right-click the server icon -> Copy Server ID.
DISCORD_SERVER_ID=

# Optional. Comma-separated Discord role IDs; only members holding one of them
# may sign in. Right-click a role in Server Settings -> Roles -> Copy Role ID.
# DISCORD_SERVER_ROLES=

# ──────────────────────────────────────────────
#  AUTHENTICATION — Microsoft Entra ID (unused)
# ──────────────────────────────────────────────

# Requires a WORK OR SCHOOL account and the ability to register an app in the
# tenant. Outline reads the tenant's organization from the Graph API to name the
# workspace; personal Microsoft accounts have no tenant and are rejected.
#   Redirect URI (Web):  https://YOUR_DOMAIN/auth/azure.callback
#   API permissions:     Microsoft Graph -> Delegated -> User.Read
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# ──────────────────────────────────────────────
#  AUTHENTICATION — Google OAuth (unused)
# ──────────────────────────────────────────────

# Create credentials at https://console.cloud.google.com/apis/credentials
#   Application type:          Web application
#   Authorized redirect URI:   https://YOUR_DOMAIN/auth/google.callback
#
# NOTE: the FIRST sign-in must use a Google Workspace account on a custom
# domain. A personal @gmail.com address is rejected when no workspace exists
# yet ("Cannot create account using personal gmail address"). Gmail addresses
# can be invited once the workspace has been created.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ──────────────────────────────────────────────
#  GITLAB TASK SYNC  (plugins/gitlab-tasks)
# ──────────────────────────────────────────────

# Pushes tasks tagged #PM/gitlab/<repo> to GitLab as issues, and ticks them off
# when the issue closes. The plugin registers no endpoints until both URL and
# token are set. See plugins/gitlab-tasks/README.md.
#
# Token needs the `api` scope (GitLab -> Edit profile -> Access Tokens).
# Every issue is created as this token's user, so a bot account is sensible.
# GITLAB_TASKS_TOKEN_FILE=/run/secrets/gitlab also works.
#
# Separate from the OIDC credentials above: sign-in is per-user OAuth, issue
# sync is one shared token.
GITLAB_TASKS_URL=https://gitlab.com
GITLAB_TASKS_TOKEN=

# Where tasks go when the repo tag matches no project. Unset means skip them.
GITLAB_TASKS_FALLBACK_PROJECT=

# Tag namespace and the marker stamped onto pushed tasks. Defaults shown.
# GITLAB_TASKS_TAG_PREFIX=PM
# GITLAB_TASKS_SYNCED_TAG=#synced

# Required for a self-hosted GitLab on a private network — outgoing requests
# are SSRF-filtered and cannot reach private IP ranges otherwise.
# GITLAB_TASKS_ALLOW_PRIVATE_IP=true

# ──────────────────────────────────────────────
#  EMAIL (optional, recommended)
# ──────────────────────────────────────────────

# Without SMTP, invites and notification emails silently won't send. Email
# sign-in also requires this — note it only works for users who already exist,
# so an SSO provider remains the way the first account is created.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=outline@example.com
# SMTP_SECURE=true

# ──────────────────────────────────────────────
#  TUNING (optional)
# ──────────────────────────────────────────────

# Node processes for the web service. Leave at 1 unless you also set
# REDIS_COLLABORATION_URL — the collaboration service is pinned to one process.
WEB_CONCURRENCY=1

# Max upload size in bytes (default 250MB).
# FILE_STORAGE_UPLOAD_MAX_SIZE=262144000

DEFAULT_LANGUAGE=en_US
LOG_LEVEL=info

# Heap ceiling in MB for the image build only. Raise if `docker compose build`
# gets killed during the Vite step.
NODE_BUILD_MEMORY=8192
